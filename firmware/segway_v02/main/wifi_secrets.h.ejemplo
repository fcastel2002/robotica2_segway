// Credenciales de la red WiFi a la que se conecta el robot. Plantilla versionada: la primera
// compilación la copia a wifi_secrets.h (main/CMakeLists.txt), que NO se versiona (.gitignore).
// Completar wifi_secrets.h, no este archivo. Con WIFI_SSID vacío el robot arranca sin WiFi y
// todo sigue por el cable.
#pragma once

#define WIFI_SSID       ""      // nombre de la red (2,4 GHz: el ESP32-S3 no tiene 5 GHz)
#define WIFI_PASSWORD   ""      // vacío si la red es abierta (también las abiertas con cifrado, OWE)
// Si hacen falta, hasta seis más: si una no aparece, el robot prueba la siguiente
// #define WIFI_SSID2      ""
// #define WIFI_PASSWORD2  ""
// #define WIFI_SSID3      ""
// #define WIFI_PASSWORD3  ""
// #define WIFI_SSID4      ""
// #define WIFI_PASSWORD4  ""
// #define WIFI_SSID5      ""
// #define WIFI_PASSWORD5  ""
// #define WIFI_SSID6      ""
// #define WIFI_PASSWORD6  ""
// #define WIFI_SSID7      ""
