# Cache y temporales de MATLAB / Simulink
slprj/
*.slxc
*.asv
*.autosave
*.mexw64

# LaTeX
*.aux
*.log
*.out
*.toc
*.synctex.gz

# SolidWorks: archivos de bloqueo
~$*

# OneNote y caches de herramientas
*.one
*.onetoc2
.codebase-memory/

# KiCad: respaldos, autoguardado, caches y estado local
*-backups/
_autosave-*
fp-info-cache
*.lck
*.kicad_prl
.history/

# Python
__pycache__/
*.pyc
.venv/
venv/

# ESP-IDF: salida de compilación y componentes descargados
firmware/**/build/
managed_components/
sdkconfig.old

# Configuración local de cada PC (rutas de ESP-IDF, puertos COM, editor): no se versiona,
# porque cambia entre máquinas. Cada uno la arma con la extensión de ESP-IDF
# ("ESP-IDF: Select Current ESP-IDF Version"). Un archivo que ya estaba versionado no se
# ignora solo: hay que sacarlo con `git rm --cached <archivo>`.
.vscode/
.idea/
*.code-workspace
**/.claude/worktrees/
**/.claude/settings.local.json
**/.claude/launch.json

# Windows y macOS
Thumbs.db
desktop.ini
.DS_Store
