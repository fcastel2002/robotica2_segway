          "hacer": "cmd",
          "texto": "set exc 0.06"
        },
        {
          "hacer": "esperar",
          "s": 7.9
        },
        {
          "hacer": "esperar_registro"
        },
        {
          "hacer": "esperar",
          "s": 2
        }
      ]
    },
    {
      "hacer": "cmd",
      "texto": "set dlpf 1"
