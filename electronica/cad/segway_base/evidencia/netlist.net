		(comp
			(ref "A5")
			(value "INA219 MCU-219 0x41 IZQ")
			(footprint "Connector_PinSocket_2.54mm:PinSocket_1x06_P2.54mm_Vertical")
			(description "ROB-002. Modulo MCU-219 (INA219, shunt R100 [H por marcado]). Tira de 6 pines en orden Vcc, Gnd, Scl, Sda, Vin-, Vin+ leido de la captura de compra [V]. Vin-/Vin+ de la tira unidos a la bornera Vin-/Vin+ del modulo [V]. En la placa base los pines 5-6 quedan sin conexion: la corriente de la rama pasa por la bornera del modulo, cableada a J21/J22, y no por contactos de 2,54 mm. Direccion por puentes A0/A1 del modulo. Pinout PENDIENTE de E-01.")
			(fields
				(field
					(name "Estado") "provisorio [H] (orden [V]; dirección 0x41 por puente A0 [H], sujeta a aprobar el cambio del contrato §4.1; pines 5-6 sin conexión: la corriente pasa por la bornera del módulo y J21; uso en rama de motor = decisión 4 de [ENERGIA] §10, pendiente de Matías y de E-04)")
				(field
					(name "Fuente") "[CAP]/ROB-002_INA219/referencia_compra.png (tira Vcc-Gnd-Scl-Sda-Vin−-Vin+ y bornera Vin−/Vin+) [V]; [DS-219] p.3, p.4, p.14 Tabla 1; [ENERGIA] §5.1-5.2")
				(field
					(name "Footprint") "Connector_PinSocket_2.54mm:PinSocket_1x06_P2.54mm_Vertical")
				(field
					(name "Datasheet")
				)
				(field
					(name "Description") "ROB-002. Modulo MCU-219 (INA219, shunt R100 [H por marcado]). Tira de 6 pines en orden Vcc, Gnd, Scl, Sda, Vin-, Vin+ leido de la captura de compra [V]. Vin-/Vin+ de la tira unidos a la bornera Vin-/Vin+ del modulo [V]. En la placa base los pines 5-6 quedan sin conexion: la corriente de la rama pasa por la bornera del modulo, cableada a J21/J22, y no por contactos de 2,54 mm. Direccion por puentes A0/A1 del modulo. Pinout PENDIENTE de E-01.")
			)
