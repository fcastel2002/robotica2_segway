		(comp
			(ref "A9")
			(value "Mini buck 3,3V ROB-005 (3V3_PER)")
			(description "ROB-005/ROB-006. Mini buck de salida fija, 4 pads de esquina IN+, IN-, OUT+, OUT- segun la miniatura de pinout de la publicacion [V]. Chip no identificado (MP1584 solo candidato). Se enchufa con un pin macho por esquina en 4 PinSocket_1x01 (DEC-13); huella PENDIENTE de medir (paso entre pads, agujero o almenado, contorno). OUT+ passive para el ERC. ROB-005 (3,3 V) y ROB-006 (5 V) son iguales a simple vista: serigrafia y medida antes de insertar. Cuatro contactos en rectangulo: admite insercion girada 180 grados, que une VM_LOG con la salida por la masa del modulo e invierte su entrada. Huella con codificacion mecanica obligatoria (propuesta 16).")
			(fields
				(field
					(name "Estado") "provisorio [H] (nuevo, a ratificar: riel 3V3_PER separado del LDO de la Blue Pill; chip y tensión máxima de entrada sin identificar (debe soportar 24,4 V); huella como A8, pendiente de E-01; excluyente con R32; medir TP10 antes de insertar MPU/INA; misma codificación mecánica que A8, porque girado lleva VM_LOG a 3V3_PER (propuesta 16))")
				(field
					(name "Fuente") "[INV] ROB-005 (5 módulos, salida fija 3,3 V) [V]; [CAP]/ROB-005_Mini_3V3/referencia_compra.png [V]; [SCH-BP] (LDO RT9193-33), [STM32-BASE] (TX6211B, 300 mA), [DESKTH] (≤100 mA para cargas externas)")
				(field
					(name "Footprint")
				)
				(field
					(name "Datasheet")
				)
				(field
					(name "Description") "ROB-005/ROB-006. Mini buck de salida fija, 4 pads de esquina IN+, IN-, OUT+, OUT- segun la miniatura de pinout de la publicacion [V]. Chip no identificado (MP1584 solo candidato). Se enchufa con un pin macho por esquina en 4 PinSocket_1x01 (DEC-13); huella PENDIENTE de medir (paso entre pads, agujero o almenado, contorno). OUT+ passive para el ERC. ROB-005 (3,3 V) y ROB-006 (5 V) son iguales a simple vista: serigrafia y medida antes de insertar. Cuatro contactos en rectangulo: admite insercion girada 180 grados, que une VM_LOG con la salida por la masa del modulo e invierte su entrada. Huella con codificacion mecanica obligatoria (propuesta 16).")
			)
			(libsource
				(lib "segway_modulos")
				(part "ROB-005-006_MiniBuck_modulo_4p")
				(description "ROB-005/ROB-006. Mini buck de salida fija, 4 pads de esquina IN+, IN-, OUT+, OUT- segun la miniatura de pinout de la publicacion [V]. Chip no identificado (MP1584 solo candidato). Se enchufa con un pin macho por esquina en 4 PinSocket_1x01 (DEC-13); huella PENDIENTE de medir (paso entre pads, agujero o almenado, contorno). OUT+ passive para el ERC. ROB-005 (3,3 V) y ROB-006 (5 V) son iguales a simple vista: serigrafia y medida antes de insertar. Cuatro contactos en rectangulo: admite insercion girada 180 grados, que une VM_LOG con la salida por la masa del modulo e invierte su entrada. Huella con codificacion mecanica obligatoria (propuesta 16).")
