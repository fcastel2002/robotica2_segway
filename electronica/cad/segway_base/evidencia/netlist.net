		(libpart
			(lib "segway_modulos")
			(part "ROB-012_ESP32-DevKitC-V4_38p")
			(description "ROB-012 provisoria (DEC-11). Placa de referencia Espressif ESP32-DevKitC V4, variante DevKitC-32E (WROOM-32E, 4 MB, sin PSRAM). Pines 1-19 = J2-1..J2-19; pines 20-38 = J3-1..J3-19 (guia oficial docs.espressif.com esp32-devkitc user_guide, tablas J2/J3, consultada 17/10/2026). 3V3 tipo passive: es salida del AMS1117 de la placa y se declara passive para que el ERC no choque con PWR_FLAG. Huella pendiente: 2x19 P2.54 con hileras a 25,40 mm (plano oficial de dimensiones), crear tras medir el ejemplar (E-01). Reemplazable: si cambia la controladora se cambia este simbolo y su huella; las nets de la placa base no cambian.")
			(fields
				(field
					(name "Reference") "A")
				(field
					(name "Value") "ESP32-DevKitC V4 (DevKitC-32E, WROOM-32E 4 MB)")
				(field
					(name "Footprint")
				)
				(field
					(name "Datasheet")
				)
				(field
					(name "Description") "ROB-012 provisoria (DEC-11). Placa de referencia Espressif ESP32-DevKitC V4, variante DevKitC-32E (WROOM-32E, 4 MB, sin PSRAM). Pines 1-19 = J2-1..J2-19; pines 20-38 = J3-1..J3-19 (guia oficial docs.espressif.com esp32-devkitc user_guide, tablas J2/J3, consultada 17/10/2026). 3V3 tipo passive: es salida del AMS1117 de la placa y se declara passive para que el ERC no choque con PWR_FLAG. Huella pendiente: 2x19 P2.54 con hileras a 25,40 mm (plano oficial de dimensiones), crear tras medir el ejemplar (E-01). Reemplazable: si cambia la controladora se cambia este simbolo y su huella; las nets de la placa base no cambian.")
			)
