		(property "Value" "Blue Pill STM32F103C8T6"
			(at 426.72 99.06 0)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "Footprint" ""
			(at 426.72 69.85 0)
			(hide yes)
			(effects
				(font
