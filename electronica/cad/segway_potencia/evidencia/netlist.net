		(comp
			(ref "A5")
			(value "INA219 MCU-219 0x41 IZQ")
			(footprint "segway_modulos:ROB-002_INA219_MCU-219_8p")
			(description "ROB-002. Modulo MCU-219 (INA219, shunt R100 [H por marcado]) enchufado en la placa base (DEC-13). Pines 1-6 = tira Vcc, Gnd, Scl, Sda, Vin-, Vin+ (captura de compra [V]). Pines 7-8 = agujeros de la bornera verde Vin-/Vin+, que viene suelta [V], con pines macho soldados en su lugar. Vin-/Vin+ de la tira y de la bornera estan unidos en el modulo [V]: 2 contactos por net de corriente (hasta 4,8 A con 3 A por contacto y factor 0,8). Huella v0.4: segway_modulos:ROB-002_INA219_MCU-219_8p; bornera de paso 3,5 mm (3,47 mm medidos en la captura de compra) a 15,72 mm de la tira; supuesta hasta E-01 (SUP-34). Direccion por los puentes A0/A1 del modulo. Pinout PENDIENTE de E-01.")
			(fields
				(field
					(name "Estado") "provisorio [H]: dirección 0x41 por puente A0 [H], sujeta al cambio del contrato §4.1; pines macho en los agujeros de la bornera, 2 contactos por net de corriente (5+7 y 6+8), ≤ 4,8 A (SUP-34, SUP-41); huella segway_modulos:ROB-002_INA219_MCU-219_8p con bornera de paso 3,5 mm medida en la captura, sin medir el módulo; J21 eliminada (SUP-63); decisión 4 de [ENERGIA] §10 pendiente")
				(field
					(name "Fuente") "[CAP]/ROB-002_INA219/referencia_compra.png (tira Vcc-Gnd-Scl-Sda-Vin−-Vin+ y bornera suelta) [V]; [DS-219] p.3, p.4, p.14 Tabla 1; [ENERGIA] §5.1-5.2; [WURTH-PHD] 3 A por contacto [V]; [DS-DRV] p.5 (IOCP mín. 3,7 A)")
				(field
