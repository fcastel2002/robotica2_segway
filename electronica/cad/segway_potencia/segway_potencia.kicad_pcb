	(footprint "segway_modulos:ROB-008_DRV8871_modulo_8p"
		(layer "F.Cu")
		(uuid "cec5b66f-9cca-4ef5-99c3-7227866a6c21")
		(at 47.4 60.96 180)
		(descr "ROB-008 modulo DRV8871 tipo Adafruit 3190 enchufado entero (DEC-13; propuesta 2 de diseno_v0.3.md, opcion B): header logico 1x04 P2,54 (1 GND, 2 VM, 3 IN1, 4 IN2) + 4 agujeros de borneras con pin macho soldado (5 POWER+, 6 POWER-, 7 OUT1, 8 OUT2), cada uno sobre un zocalo hembra 1x01. Geometria de drv.brd en https://github.com/adafruit/Adafruit-DRV8871-Breakout-PCB (SHA-256 9ef03092...): placa 20,32x24,13 mm, JP2 1X04 en y=2,54; X1 DCMOTOR y X2 POWER TERMBLOCK_1X2-3.5MM en y=20,32. Rotada 180 grados respecto de la vista superior de Eagle (rotacion, no espejo): pad n = pin n del simbolo. SUPUESTOS pendientes de E-01: el clon ROB-008 replica esa geometria (SUP-HB-DRV-1); paso de bornera 3,5 mm (SUP-HB-DRV-2). Fabricacion casera: una capa, pad 2,2/taladro 1,0 (paso 2,54) y 2,8/1,3 en los pines de bornera (paso 3,5: separacion cobre-cobre 0,7 mm; con 3,0 quedaria 0,5 mm).")
		(tags "DRV8871 Adafruit 3190 modulo enchufable zocalo bornera THT casero")
		(property "Reference" "A4"
			(at 3.81 -4.34 180)
