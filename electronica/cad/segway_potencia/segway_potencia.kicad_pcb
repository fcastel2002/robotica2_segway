	(footprint "segway_modulos:ROB-008_DRV8871_modulo_8p"
		(layer "F.Cu")
		(uuid "0e9ef4b3-95c0-4670-8454-95b23e6bfc03")
		(at 95.4 60.96 180)
		(descr "Corregida el 31/10/2026 con las fotos de los modulos comprados (revision independiente v0.4): el clon ROB-008 tiene borneras de paso 5,0 mm igualmente espaciadas, no de 3,5 mm como la Adafruit 3190. Medido en las fotos respecto del pin GND de la tira (escala: paso 2,54 de la tira): POWER- -3,0/-3,6, POWER+ +1,5/+1,9, OUT1 +6,5/+6,6, OUT2 +10,9/+11,3; se ajusto paso 5,0 centrado: -3,5, +1,5, +6,5, +11,5 (SUP-32, confirmar con calibre antes de taladrar). Tira logica 1x04 P2,54 (1 GND, 2 VM, 3 IN1, 4 IN2) a 17,78 mm de las borneras (medido 17,7). 4 agujeros de bornera con pin macho soldado (5 POWER+, 6 POWER-, 7 OUT1, 8 OUT2) sobre zocalos hembra 1x01. Placa de unos 20,3 x 24,1 mm. Rotada 180 grados respecto de la vista superior (rotacion, no espejo): pad n = pin n del simbolo. Fabricacion casera: una capa, pad 2,2/taladro 1,0 en la tira y 2,8/1,3 en las borneras.")
		(tags "DRV8871 Adafruit 3190 modulo enchufable zocalo bornera THT casero")
		(property "Reference" "A3"
			(at 3.81 -4.34 180)
			(layer "F.SilkS")
			(uuid "1c866a4c-7262-41a7-9863-8c433a3a9734")
			(effects
				(font
					(size 1 1)
					(thickness 0.15)
				)
			)
		)
		(property "Value" "DRV8871 mód. IZQ (enchufable)"
			(at 3.81 23.19 180)
			(layer "F.Fab")
			(uuid "b9a40650-e842-47f3-90d9-93f721b0fa75")
			(effects
				(font
					(size 1 1)
					(thickness 0.15)
				)
			)
		)
		(property "Datasheet" ""
			(at 0 0 180)
			(layer "F.Fab")
			(hide yes)
			(uuid "562854a0-2ada-4f0d-b680-22e5a21587b9")
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "Description" "ROB-008. Modulo DRV8871 tipo Adafruit 3190 (equivalencia del clon [H]) enchufado entero en la placa base (DEC-13, opcion B). Pines 1-4 = header logico 1 = GND, 2 = VM, 3 = IN1, 4 = IN2 (drv.brd de Adafruit, JP2 [D-ref]; serigrafia alternada del clon [V]). Pines 5-8 = agujeros de las borneras POWER (5 = POWER+ = VM, 6 = POWER- = GND) y MOTOR (7 = OUT1, 8 = OUT2), con pines macho soldados en lugar de las borneras. VM y GND del header estan unidos a POWER dentro del modulo (Adafruit Learn, Pinouts): 2 contactos en paralelo por net de potencia. Huella v0.4: segway_modulos:ROB-008_DRV8871_modulo_8p, geometria del drv.brd de Adafruit 3190 vista desde arriba y girada 180 grados (borneras de paso 3,5 mm a 17,78 mm del header); supuesta hasta E-01 (SUP-32). La opcion A (J5/J6) se elimino en la v0.4 (SUP-63). Pinout PENDIENTE de E-01."
			(at 0 0 180)
			(layer "F.Fab")
			(hide yes)
			(uuid "7c7bfad8-bcde-466a-b45d-7f8a8df726ac")
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "Estado" "provisorio [H]: opción B fija, con las borneras POWER y MOTOR del módulo reemplazadas por pines macho (SUP-32); huella segway_modulos:ROB-008_DRV8871_modulo_8p con la geometría del drv.brd de Adafruit 3190, sin medir el clon; OUT1/OUT2 con un contacto solo si ITRIP ≤ 2,4 A (RILIM ≥ 28,75 kΩ, leer en E-01); opción A (J5) eliminada (SUP-63)"
			(at 0 0 180)
			(layer "F.SilkS")
			(hide yes)
			(uuid "4dc353c3-4bdc-421d-a123-4605c9d219b7")
			(effects
				(font
					(size 1.27 1.27)
					(thickness 0.15)
				)
			)
		)
		(property "Fuente" "[CAP]/ROB-008_DRV8871/referencia_compra.png [V]; drv.brd de Adafruit, JP2 1=GND 2=VMOTOR 3=IN1 4=IN2 [D-ref]; [ADA-3190] (borneras soldadas de fábrica; VM y GND del header unidos a POWER); [DS-DRV] p.5 (IOCP 3,7-6,4 A), p.9 (ITRIP = VILIM/RILIM); [WURTH-PHD] 3 A por contacto [V]"
