	(footprint "segway_modulos:ROB-008_DRV8871_modulo_8p"
		(layer "F.Cu")
		(uuid "e3c68bd0-04ff-4dc6-9aed-01a564ce5ef8")
		(at 47.4 60.96 180)
		(descr "Corregida el 31/10/2026 con las fotos de los modulos comprados (revision independiente v0.4): el clon ROB-008 tiene borneras de paso 5,0 mm igualmente espaciadas, no de 3,5 mm como la Adafruit 3190. Medido en las fotos respecto del pin GND de la tira (escala: paso 2,54 de la tira): POWER- -3,0/-3,6, POWER+ +1,5/+1,9, OUT1 +6,5/+6,6, OUT2 +10,9/+11,3; se ajusto paso 5,0 centrado: -3,5, +1,5, +6,5, +11,5 (SUP-32, confirmar con calibre antes de taladrar). Tira logica 1x04 P2,54 (1 GND, 2 VM, 3 IN1, 4 IN2) a 17,78 mm de las borneras (medido 17,7). 4 agujeros de bornera con pin macho soldado (5 POWER+, 6 POWER-, 7 OUT1, 8 OUT2) sobre zocalos hembra 1x01. Placa de unos 20,3 x 24,1 mm. Rotada 180 grados respecto de la vista superior (rotacion, no espejo): pad n = pin n del simbolo. Fabricacion casera: una capa, pad 2,2/taladro 1,0 en la tira y 2,8/1,3 en las borneras.")
		(tags "DRV8871 Adafruit 3190 modulo enchufable zocalo bornera THT casero")
		(property "Reference" "A4"
			(at 3.81 -4.34 180)
