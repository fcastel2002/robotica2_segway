					(size 1.27 1.27)
				)
			)
		)
		(property "Estado" "provisorio [H]: dirección 0x44 por puente A1 [H], sujeta al cambio del contrato §4.1; mismas condiciones de zócalo y huella que A5 (SUP-34); J22 eliminada (SUP-63)"
			(at 0 0 0)
