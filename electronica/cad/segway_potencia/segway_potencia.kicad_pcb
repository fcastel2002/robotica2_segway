	(footprint "segway_modulos:ROB-002_INA219_MCU-219_8p"
		(layer "F.Cu")
		(uuid "cc09d003-c600-4118-8d0f-f72f3e5b15ec")
		(at 102.5 58.9)
		(descr "ROB-002 modulo MCU-219 (INA219, shunt R100) enchufado (DEC-13; propuesta 3 de diseno_v0.3.md): tira 1x06 P2,54 (1 Vcc, 2 Gnd, 3 Scl, 4 Sda, 5 Vin-, 6 Vin+) + 2 agujeros de la bornera suelta con pin macho soldado (7 Vin-, 8 Vin+), cada uno sobre un zocalo hembra 1x01. Sin plano oficial: posiciones medidas en la captura de compra (componentes_comprados/datasheets/ROB-002_INA219/referencia_compra.png) con el paso de 2,54 mm como escala; placa 25x22 mm segun https://protosupplies.com/product/ina219-dc-current-measurement-module/. SUPUESTOS pendientes de E-01: bornera de 3,5 mm de paso, medida 3,47 mm en la captura; el simbolo dice 5,0/5,08 [H] (SUP-HB-INA-1); bornera centrada en x=6,05, y=-15,72 respecto del pin 1 (SUP-HB-INA-2); contorno de 25x22 mm y agujeros de montaje (SUP-HB-INA-3). Fabricacion casera: una capa, pad 2,2/taladro 1,0 (paso 2,54) y 2,8/1,3 en los pines de bornera (paso 3,5: separacion cobre-cobre 0,7 mm; con 3,0 quedaria 0,5 mm).")
		(tags "INA219 MCU-219 CJMCU-219 modulo enchufable zocalo bornera THT casero")
