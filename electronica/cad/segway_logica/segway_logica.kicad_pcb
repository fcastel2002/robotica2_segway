	(footprint "segway_modulos:ROB-013_MPU6050_modulo_8p"
		(layer "F.Cu")
		(uuid "cceb47d1-fcc4-4d3b-8ca2-8d9f7d4b184d")
		(at 58.42 69.85)
		(descr "ROB-013 modulo MPU6050 formato GY-521 enchufado en zocalo hembra 1x08 P2,54 (DEC-13, REQ-22). Pad n = pin n del simbolo segway_modulos:ROB-013_MPU6050_modulo_8p (1 VCC, 2 GND, 3 SCL, 4 SDA, 5 XDA, 6 XCL, 7 AD0, 8 INT), hilera horizontal y cuerpo del modulo hacia -Y (vista superior con VCC a la izquierda, como la foto de ROB-013 girada 180 grados). SUPUESTOS (foto de catalogo, no medido): placa 21 x 16 mm (SUP-HA-MPU-1; openelab Wheeltec indica 20,5 x 15,5); hilera a 1,35 mm del borde (SUP-HA-MPU-2); dos agujeros de 3,2 mm a 15 mm entre centros y 11,8 mm de la hilera (SUP-HA-MPU-3), repetidos en la base como NPTH 3,2 mm para separadores opcionales. Codificacion: pin 5 (XDA) retirado y posicion 5 del zocalo tapada (diseno_v0.3.md, propuesta 16). Fabricacion casera: pad 2,2 mm, taladro 1,0 mm.")
		(tags "MPU6050 GY-521 IMU modulo zocalo 1x08 THT casero")
		(property "Reference" "A2"
			(at 8.89 -15.95 0)
			(layer "F.SilkS")
			(uuid "42f2dea1-c6b9-4e4b-b441-b80dd82954c1")
			(effects
				(font
					(size 1 1)
					(thickness 0.15)
				)
			)
		)
		(property "Value" "GY-521 MPU6050 0x68"
			(at 8.89 4.25 0)
			(layer "F.Fab")
			(uuid "159154bd-c461-4615-8507-e28b305471ce")
			(effects
				(font
					(size 1 1)
					(thickness 0.15)
				)
			)
		)
		(property "Datasheet" ""
			(at 0 0 0)
			(layer "F.Fab")
			(hide yes)
			(uuid "2a8ecb34-0e32-4f2f-b031-bbc7e1c33c47")
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "Description" "ROB-013. Modulo MPU6050 de 8 pines, formato GY-521 segun imagen de Matias del 17/10/2026. Orden VCC,GND,SCL,SDA,XDA,XCL,AD0,INT leido de la serigrafia [V]; numeracion 1=VCC provisoria hasta ver el pad cuadrado del ejemplar. Huella v0.4: segway_modulos:ROB-013_MPU6050_modulo_8p (zocalo 1x08 de 2,54 mm y dos NPTH de 3,2 mm para separadores; contorno supuesto sin medir, SUP-36). En la v0.4 AD0 queda sin conexion: la pull-down del GY-521 fija 0x68 (SUP-36, SUP-66). Codificacion propuesta: pin 5 (XDA, sin uso) retirado de la tira macho y posicion 5 del zocalo tapada; invertido (n -> 9-n), el pin 4 (SDA) cae en la 5 y no entra."
			(at 0 0 0)
			(layer "F.Fab")
			(hide yes)
			(uuid "931c3c59-c8c4-46a9-8a69-a17ef47d75bb")
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "Estado" "provisorio [H] (orden de pines [V]/[M]; zócalo estándar 1x08 (DEC-13); alimentado desde 3V3_MCU; contorno del módulo pendiente de medida; codificación propuesta: retirar el pin 5 (XDA, sin uso) de la tira macho y tapar la posición 5 del zócalo, porque invertido llevaría 3V3_MCU a INT y el VCC del módulo a PB14) | v0.4: huella segway_modulos:ROB-013_MPU6050_modulo_8p (1x08 + 2 NPTH de 3,2 mm, contorno supuesto); AD0 (pin 7) sin conexión: la pull-down del GY-521 fija 0x68 (SUP-36, SUP-66); sin pistas debajo"
			(at 0 0 0)
			(layer "F.SilkS")
			(hide yes)
			(uuid "30df662f-9324-4785-b761-c9184cba674c")
			(effects
				(font
					(size 1.27 1.27)
					(thickness 0.15)
				)
			)
		)
		(property "Fuente" "DEC-09 [M]; [CAP]/ROB-013_MPU6050/referencia_modulo_matias_2026-10-17.png [V]; [DS-MPU] p.14, p.15, p.21, p.33"
			(at 0 0 0)
