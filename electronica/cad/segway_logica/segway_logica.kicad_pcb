	(footprint "segway_modulos:ROB-013_MPU6050_modulo_8p"
		(layer "F.Cu")
		(uuid "fe8b77b7-33ba-4c27-9929-3eaa135a9b48")
		(at 60.169999 74.22 90)
		(descr "ROB-013 modulo MPU6050 formato GY-521 enchufado en zocalo hembra 1x08 P2,54 (DEC-13, REQ-22). Pad n = pin n del simbolo segway_modulos:ROB-013_MPU6050_modulo_8p (1 VCC, 2 GND, 3 SCL, 4 SDA, 5 XDA, 6 XCL, 7 AD0, 8 INT), hilera horizontal y cuerpo del modulo hacia -Y (vista superior con VCC a la izquierda, como la foto de ROB-013 girada 180 grados). SUPUESTOS (foto de catalogo, no medido): placa 21 x 16 mm (SUP-HA-MPU-1; openelab Wheeltec indica 20,5 x 15,5); hilera a 1,35 mm del borde (SUP-HA-MPU-2); dos agujeros de 3,2 mm a 15 mm entre centros y 11,8 mm de la hilera (SUP-HA-MPU-3), repetidos en la base como NPTH 3,2 mm para separadores opcionales. Codificacion: pin 5 (XDA) retirado y posicion 5 del zocalo tapada (diseno_v0.3.md, propuesta 16). Fabricacion casera: pad 2,2 mm, taladro 1,0 mm.")
		(tags "MPU6050 GY-521 IMU modulo zocalo 1x08 THT casero")
		(property "Reference" "A2"
			(at 8.89 -15.95 90)
