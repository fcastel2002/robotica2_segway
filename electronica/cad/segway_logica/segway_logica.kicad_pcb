	(footprint "segway_modulos:ROB-005-006_MiniBuck_modulo_4p"
		(layer "F.Cu")
		(uuid "0a1d6869-2522-403a-830c-6a6ae778d1eb")
		(at 37.4 116.9 90)
		(descr "ROB-005 (3,3 V) / ROB-006 (5 V) mini buck fijo tipo MP1584 (chip no identificado). Se enchufa con un pin macho por esquina sobre 4 zocalos hembra 1x01 (DEC-13). Pads 1 IN+, 2 IN-, 3 OUT+, 4 OUT- = pines del simbolo. Fabricacion casera: una capa B.Cu, pad 3,0 mm / taladro 1,3 mm (potencia), pad 1 cuadrado. Codificacion mecanica contra el giro de 180 grados (propuesta 16) NO incluida: requiere medir el ejemplar en E-01 (punto abierto); solo serigrafia IN > OUT y signos. Vista superior con el componente arriba: IN+ e IN- en el lado corto izquierdo, OUT+ y OUT- en el derecho, + arriba. SUPUESTOS pendientes de E-01: contorno 22x17 mm (SUP-HC-MB-1; ficha comercial referencias_no_confirmadas/ficha_comercial_Mini_MP1584_LazyAutomation.html y https://zbotic.in/product/mini-mp1584-dc-dc-3a-adjustable-buck-module/); centros de pad a 1,5 mm de cada borde, rectangulo de 19,0x14,0 mm (SUP-HC-MB-2, sin plano publicado); IN en un lado corto y OUT en el opuesto, con los + sobre el mismo lado largo (SUP-HC-MB-3; la miniatura de pinout de la captura de ROB-005 es ilegible a esa escala).")
		(tags "MP1584 mini buck modulo enchufable zocalo THT casero")
		(property "Reference" "A9"
			(at 9.5 -3.1 90)
			(layer "F.SilkS")
			(uuid "1f319416-573f-40c3-85e2-162725f215bc")
			(effects
				(font
					(size 1 1)
					(thickness 0.15)
				)
			)
		)
		(property "Value" "Mini buck 3,3V ROB-005"
			(at 9.5 17.1 90)
			(layer "F.Fab")
			(uuid "15a7704f-7169-4e40-89c0-9432fe2339ca")
			(effects
				(font
					(size 1 1)
					(thickness 0.15)
				)
			)
		)
		(property "Datasheet" ""
			(at 0 0 90)
			(layer "F.Fab")
			(hide yes)
			(uuid "b14a4e8a-7b09-4854-b98c-902fe4d4470f")
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "Description" "ROB-005/ROB-006. Mini buck de salida fija, 4 pads de esquina IN+, IN-, OUT+, OUT- segun la miniatura de pinout de la publicacion [V]. Chip no identificado (MP1584 solo candidato). Se enchufa con un pin macho por esquina en 4 PinSocket_1x01 (DEC-13); huella v0.4 segway_modulos:ROB-005-006_MiniBuck_modulo_4p con pads en un rectangulo de 19,0 x 14,0 mm supuesto (SUP-37). OUT+ passive para el ERC. ROB-005 (3,3 V) y ROB-006 (5 V) son iguales a simple vista: serigrafia y medida antes de insertar. Cuatro contactos en rectangulo: admite insercion girada 180 grados, que une VM_LOG con la salida por la masa del modulo e invierte su entrada. Codificacion en la v0.1: A8 girado 90 grados respecto de A9 y rotulos 5V/3V3 en el cobre; el tope definitivo se agrega tras E-01 (SUP-38)."
			(at 0 0 90)
			(layer "F.Fab")
			(hide yes)
			(uuid "fa897ddf-64fc-410a-881b-283ee6d22c52")
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "Estado" "provisorio [H]: soldado (entra girado y quemaría, SUP-80); 5V_MCU -> 3V3_MCU a los pines 3V3 de la ESP32 (SUP-26, SUP-31)"
			(at 0 0 90)
			(layer "F.SilkS")
			(hide yes)
			(uuid "5641a9f2-5e01-4ab6-ab57-e74aa74a9418")
			(effects
